# Frontend environment — copy to .env.local and fill in from your
# Supabase project (Dashboard → Settings → API).
#
# These are NEXT_PUBLIC_ vars: inlined into the client bundle at build time.
# On Vercel they MUST also be set in Project → Settings → Environment
# Variables (frontend service scope) — a deploy without them builds cleanly
# but every page returns 500 (auth middleware has no project to talk to).
# After changing them, redeploy so the bundle is rebuilt.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: absolute backend URL if the browser should call FastAPI
# directly instead of same-origin /api (Docker/Vercel default: leave unset).
# NEXT_PUBLIC_API_URL=
