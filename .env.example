# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Optional: the quiz endpoint returns 500/503 without it; the reader works fine.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: browser origins allowed to call the API directly.
# Default: http://localhost:3000,http://127.0.0.1:3000
# Not required when using the Next.js /api proxy (Docker default).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase backend credentials (service role) — for persistent words-folded counter.
# Leave unset to fall back to in-memory counting.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
